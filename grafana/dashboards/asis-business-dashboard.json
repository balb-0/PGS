{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\"}",
        "iconColor": "red",
        "name": "Alerts",
        "titleFormat": "{{ alertname }}"
      }
    ]
  },
  "description": "Dashboard executivo de negocio para decisao rapida com SLA, volume, eficiencia e risco.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "includeVars": true,
      "keepTime": true,
      "title": "Saude do Sistema",
      "type": "dashboards",
      "uid": "asis-system-health-dashboard"
    },
    {
      "includeVars": true,
      "keepTime": true,
      "title": "Testes Restantes",
      "type": "dashboards",
      "uid": "asis-testing-gap-dashboard"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Visao Executiva de Negocio",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 98 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Taxa de Sucesso",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * sum(rate(asis_requests_total{endpoint=~\"$endpoint\",status=\"success\",source=~\"$source\"}[$interval])) / clamp_min(sum(rate(asis_requests_total{endpoint=~\"$endpoint\",source=~\"$source\"}[$interval])), 0.0001)",
          "legendFormat": "Sucesso"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.65 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Latencia P90 (SLA)",
      "type": "gauge",
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum(rate(asis_request_duration_seconds_bucket{endpoint=~\"$endpoint\",source=~\"$source\"}[$interval])) by (le))",
          "legendFormat": "P90"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "auto" },
      "title": "Throughput Atual",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(asis_requests_total{endpoint=~\"$endpoint\",source=~\"$source\"}[$interval]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto" },
      "title": "Processos no Store",
      "type": "stat",
      "targets": [
        {
          "expr": "asis_process_store_size",
          "legendFormat": "Processos"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Tendencia de Latencia (P50/P90/P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(asis_request_duration_seconds_bucket{endpoint=~\"$endpoint\",source=~\"$source\"}[$interval])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(asis_request_duration_seconds_bucket{endpoint=~\"$endpoint\",source=~\"$source\"}[$interval])) by (le))",
          "legendFormat": "P90"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(asis_request_duration_seconds_bucket{endpoint=~\"$endpoint\",source=~\"$source\"}[$interval])) by (le))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "title": "Volume por Endpoint (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(asis_requests_total{endpoint=~\"$endpoint\",source=~\"$source\"}[$interval])) by (endpoint)",
          "legendFormat": "{{ endpoint }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Erros por Status e Fonte",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(asis_requests_total{endpoint=~\"$endpoint\",status=~\"$status\",source=~\"$source\"}[5m])) by (status, source)",
          "legendFormat": "{{ status }} / {{ source }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "options": { "showHeader": true, "sortBy": [{ "desc": true, "displayName": "Erros" }] },
      "title": "Erros de Validacao por Tipo e Campo",
      "type": "table",
      "targets": [
        {
          "expr": "sum(increase(asis_validation_errors_total[$interval])) by (validation_type, field)",
          "legendFormat": "{{ validation_type }} / {{ field }}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "validation_type": "Tipo",
              "field": "Campo",
              "Value": "Erros"
            }
          }
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Tendencia de Throughput por Metodo",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(asis_requests_total{endpoint=~\"$endpoint\",method=~\"$method\",source=~\"$source\"}[$interval])) by (method)",
          "legendFormat": "{{ method }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Crescimento do Audit Log",
      "type": "timeseries",
      "targets": [
        {
          "expr": "asis_audit_log_size",
          "legendFormat": "Audit Log Size"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["asis", "business", "executivo", "sla"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "5m", "value": "5m" },
        "label": "Intervalo",
        "name": "interval",
        "options": [
          { "selected": false, "text": "30s", "value": "30s" },
          { "selected": false, "text": "1m", "value": "1m" },
          { "selected": true, "text": "5m", "value": "5m" },
          { "selected": false, "text": "15m", "value": "15m" }
        ],
        "query": "30s,1m,5m,15m",
        "type": "custom"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(asis_requests_total, endpoint)",
        "includeAll": true,
        "label": "Endpoint",
        "multi": true,
        "name": "endpoint",
        "query": "label_values(asis_requests_total, endpoint)",
        "refresh": 2,
        "type": "query",
        "current": { "selected": true, "text": "All", "value": ".*" },
        "allValue": ".*"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(asis_requests_total, method)",
        "includeAll": true,
        "label": "Metodo",
        "multi": true,
        "name": "method",
        "query": "label_values(asis_requests_total, method)",
        "refresh": 2,
        "type": "query",
        "current": { "selected": true, "text": "All", "value": ".*" },
        "allValue": ".*"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(asis_requests_total, status)",
        "includeAll": true,
        "label": "Status",
        "multi": true,
        "name": "status",
        "query": "label_values(asis_requests_total, status)",
        "refresh": 2,
        "type": "query",
        "current": { "selected": true, "text": "All", "value": ".*" },
        "allValue": ".*"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(asis_requests_total, source)",
        "includeAll": true,
        "label": "Fonte",
        "multi": true,
        "name": "source",
        "query": "label_values(asis_requests_total, source)",
        "refresh": 2,
        "type": "query",
        "current": { "selected": true, "text": "All", "value": ".*" },
        "allValue": ".*"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "ASIS TaxTech - Dashboard de Negocio",
  "uid": "asis-business-dashboard",
  "version": 1,
  "weekStart": ""
}